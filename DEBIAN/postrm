#!/bin/sh
set -e

APP_ID="lan-mac-finder"
APP_USER="lan-mac-finder"
SYSTEM_ID="lanmacfinder-system"
APP_DIR="/usr/local/${APP_ID}"
UNIT_DST="/etc/systemd/system/${SYSTEM_ID}.service"

rm -f "${UNIT_DST}" 2>/dev/null || true
rm -f "/var/api/${APP_ID}.sock" 2>/dev/null || true

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
fi

case "$1" in
    remove|purge)
        # webui/ is generated by postinst and is not owned by the Deb payload.
        # Remove only this application's directory; never touch shared paths.
        rm -rf "${APP_DIR}" 2>/dev/null || true
        ;;
esac

if [ "$1" = "purge" ] && id "${APP_USER}" >/dev/null 2>&1; then
    userdel "${APP_USER}" 2>/dev/null || true
fi

exit 0
