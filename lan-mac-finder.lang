[zh-cn]
name = "局域网 MAC 查询"
auth = "qishiyi"
descript = "发现当前局域网设备，读取网卡、IP、MAC 状态，并按 MAC 后四位快速定位设备。"
release_note = "1.0.011：合并同一网段下多块 OVS 或物理网卡发现的重复设备，并对相同网段只扫描一次，减少耗时和重复结果。"
important = "扫描只读取本机路由和邻居表，不会更改 NAS 或其他设备的网络配置。"

[zh-hk]
name = "區域網絡 MAC 搜尋"
auth = "qishiyi"
descript = "搜尋目前區域網絡裝置，讀取網卡、IP、MAC 狀態，並按 MAC 尾四位定位裝置。"
release_note = "1.0.011：合併同一網段下多塊 OVS 或實體網卡發現的重複裝置，並對相同網段只掃描一次，減少耗時和重複結果。"
important = "掃描只讀取本機路由和鄰居表，不會更改 NAS 或其他裝置的網絡設定。"

[en-us]
name = "LAN MAC Finder"
auth = "qishiyi"
descript = "Find devices on the current LAN and match the last four MAC characters with live interface and neighbor data."
release_note = "1.0.011: deduplicates devices found through multiple OVS or physical interfaces on the same network and sweeps each network only once, reducing scan time and duplicate rows."
important = "The app only reads local routing and neighbor data. It never changes NAS or device network settings."

[fr-fr]
name = "Recherche MAC LAN"
auth = "qishiyi"
descript = "Trouvez les appareils du reseau local et filtrez-les par les quatre derniers caracteres de leur adresse MAC."
release_note = "1.0.011 : déduplique les appareils détectés via plusieurs interfaces OVS ou physiques sur le même réseau et ne balaye chaque réseau qu'une seule fois, réduisant la durée et les doublons."
important = "L'application lit uniquement le routage local et la table voisine, sans modifier la configuration reseau."

[de-de]
name = "LAN-MAC-Suche"
auth = "qishiyi"
descript = "Findet Geraete im aktuellen LAN und filtert sie anhand der letzten vier MAC-Zeichen."
release_note = "1.0.011: entfernt doppelte Geräte, die über mehrere OVS- oder physische Schnittstellen im selben Netz erkannt wurden, und scannt jedes Netz nur einmal, wodurch Laufzeit und doppelte Zeilen sinken."
important = "Die App liest nur lokale Routing- und Nachbardaten und aendert keine Netzwerkeinstellungen."

[it-it]
name = "Ricerca MAC LAN"
auth = "qishiyi"
descript = "Trova i dispositivi nella LAN corrente e filtra per gli ultimi quattro caratteri dell'indirizzo MAC."
release_note = "1.0.011: elimina i duplicati rilevati tramite più interfacce OVS o fisiche sulla stessa rete e analizza ogni rete una sola volta, riducendo tempi e righe duplicate."
important = "L'app legge solo routing e tabella dei vicini e non modifica la configurazione di rete."

[es-es]
name = "Buscador MAC LAN"
auth = "qishiyi"
descript = "Encuentra dispositivos en la LAN actual y filtra por los ultimos cuatro caracteres de su direccion MAC."
release_note = "1.0.011: elimina los dispositivos duplicados detectados por varias interfaces OVS o físicas en la misma red y analiza cada red una sola vez, reduciendo el tiempo y las filas repetidas."
important = "La aplicacion solo lee el enrutamiento y la tabla de vecinos sin cambiar la configuracion de red."

[hu-hu]
name = "LAN MAC kereső"
auth = "qishiyi"
descript = "Megkeresi az aktuális LAN eszközeit, és a MAC-cím utolsó négy karaktere alapján szűri őket."
release_note = "1.0.011: eltávolítja az ugyanazon hálózaton több OVS vagy fizikai interfészen keresztül talált duplikált eszközöket, és minden hálózatot csak egyszer szkennel, csökkentve az időt és az ismétlődő sorokat."
important = "Az alkalmazás csak helyi útvonal- és szomszédadatokat olvas, hálózati beállítást nem módosít."

[ja-jp]
name = "LAN MAC 検索"
auth = "qishiyi"
descript = "現在の LAN 上のデバイスを検出し、MAC アドレスの末尾 4 文字で絞り込みます。"
release_note = "1.0.011：同じネットワーク上の複数の OVS または物理インターフェースで見つかった重複デバイスを統合し、各ネットワークのスキャンを1回だけ実行して、時間と重複行を削減しました。"
important = "ローカルのルーティング情報と近隣テーブルのみを読み取り、ネットワーク設定は変更しません。"

[ko-kr]
name = "LAN MAC 찾기"
auth = "qishiyi"
descript = "현재 LAN의 장치를 찾고 MAC 주소 마지막 네 문자로 빠르게 구분합니다."
release_note = "1.0.011: 동일 네트워크의 여러 OVS 또는 물리 인터페이스에서 발견된 중복 장치를 병합하고 각 네트워크를 한 번만 검색하여 시간과 중복 행을 줄입니다."
important = "앱은 로컬 라우팅과 이웃 테이블만 읽으며 네트워크 설정을 변경하지 않습니다."

[pl-pl]
name = "Wyszukiwarka MAC LAN"
auth = "qishiyi"
descript = "Znajduje urzadzenia w biezacej sieci LAN i filtruje je po czterech ostatnich znakach adresu MAC."
release_note = "1.0.011: usuwa duplikaty urządzeń wykrytych przez wiele interfejsów OVS lub fizycznych w tej samej sieci i skanuje każdą sieć tylko raz, skracając czas i ograniczając powtarzające się wiersze."
important = "Aplikacja tylko odczytuje lokalne trasy i tabele sasiadow, bez zmiany konfiguracji sieci."

[ru-ru]
name = "Поиск MAC в LAN"
auth = "qishiyi"
descript = "Находит устройства в текущей локальной сети и фильтрует их по последним четырём символам MAC."
release_note = "1.0.011: объединяет повторяющиеся устройства, найденные через несколько OVS- или физических интерфейсов одной сети, и сканирует каждую сеть только один раз, сокращая время и дублирующиеся строки."
important = "Приложение только читает локальную маршрутизацию и таблицу соседей, не меняя настройки сети."

[tr-tr]
name = "LAN MAC Bulucu"
auth = "qishiyi"
descript = "Geçerli LAN cihazlarını bulur ve MAC adresinin son dört karakterine göre filtreler."
release_note = "1.0.011: aynı ağdaki birden fazla OVS veya fiziksel arayüzden bulunan yinelenen cihazları birleştirir ve her ağı yalnızca bir kez tarayarak süreyi ve yinelenen satırları azaltır."
important = "Uygulama yalnızca yerel yönlendirme ve komşu verilerini okur, ağ ayarlarını değiştirmez."

[pt-pt]
name = "Localizador MAC LAN"
auth = "qishiyi"
descript = "Encontra dispositivos na LAN atual e filtra pelos quatro ultimos caracteres do endereco MAC."
release_note = "1.0.011: remove dispositivos duplicados encontrados por várias interfaces OVS ou físicas na mesma rede e verifica cada rede apenas uma vez, reduzindo o tempo e as linhas repetidas."
important = "A aplicacao apenas le o encaminhamento local e a tabela de vizinhos sem alterar a configuracao de rede."
